<%# pages/lluvias.ejs — La lluvia de cada lote (pluviómetro > estación cercana > Open-Meteo) + carga de pluviómetro %>

<div class="page-header">
  <div>
    <h2>Lluvias</h2>
    <p>Lluvia de cada lote: pluviómetro del campo, estación cercana u Open-Meteo</p>
  </div>
  <div style="display:flex;gap:8px">
    <button class="btn" onclick="lluAnalizar()">✦ Analizar con agrarIA</button>
    <button class="btn btn-ghost" onclick="lluCargarLote()">↻</button>
  </div>
</div>

<!-- Selector de lote y ventana -->
<div class="card" style="padding:12px 16px;margin-bottom:16px;display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
  <label style="font-size:11px;color:var(--ap-muted);flex:1;min-width:200px">Lote
    <select id="llu-sel-lote" onchange="lluElegirLote(this.value)"
      style="width:100%;margin-top:4px;background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text);padding:8px;border-radius:8px;font-size:13px;outline:none">
      <option value="">Cargando lotes…</option>
    </select>
  </label>
  <label style="font-size:11px;color:var(--ap-muted)">Período
    <select id="llu-sel-dias" onchange="lluCargarLote()"
      style="width:100%;margin-top:4px;background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text);padding:8px;border-radius:8px;font-size:13px;outline:none">
      <option value="30">30 días</option>
      <option value="90">90 días</option>
      <option value="180">6 meses</option>
      <option value="365" selected>1 año</option>
    </select>
  </label>
</div>

<!-- Métricas del lote -->
<div id="llu-metrics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:16px"></div>

<div style="display:grid;grid-template-columns:340px 1fr;gap:16px;align-items:start">

  <!-- Columna izquierda: pluviómetro -->
  <div style="display:flex;flex-direction:column;gap:16px">
    <div class="card" id="llu-form-card" style="padding:16px">
      <div style="font-size:14px;font-weight:600">Cargar pluviómetro</div>
      <div style="font-size:11px;color:var(--ap-muted);margin:2px 0 12px">Lo medido en el campo reemplaza a cualquier otra fuente ese día.</div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <label style="font-size:11px;color:var(--ap-muted)">Fecha
          <input type="date" id="llu-fecha" style="width:100%;margin-top:4px;background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text);padding:8px;border-radius:8px;font-size:13px;outline:none"/>
        </label>
        <label style="font-size:11px;color:var(--ap-muted)">Milímetros
          <input type="number" id="llu-mm" min="0" max="1000" step="0.5" placeholder="Ej: 25"
            style="width:100%;margin-top:4px;background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text);padding:8px;border-radius:8px;font-size:13px;outline:none"/>
        </label>
        <label style="font-size:11px;color:var(--ap-muted)">Lote
          <select id="llu-lote"
            style="width:100%;margin-top:4px;background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text);padding:8px;border-radius:8px;font-size:13px;outline:none">
          </select>
        </label>
        <label style="font-size:11px;color:var(--ap-muted)">Nota (opcional)
          <input type="text" id="llu-nota" placeholder="Observación"
            style="width:100%;margin-top:4px;background:var(--ap-bg);border:1px solid var(--ap-border);color:var(--ap-text);padding:8px;border-radius:8px;font-size:13px;outline:none"/>
        </label>
        <button class="btn" style="width:100%" onclick="lluGuardar()">Guardar</button>
        <div id="llu-form-msg" style="font-size:11px;color:var(--ap-muted)"></div>
      </div>
    </div>

    <div class="card" style="padding:16px">
      <div style="font-size:14px;font-weight:600;margin-bottom:4px">Fuentes de este lote</div>
      <div id="llu-fuentes" style="font-size:12px;color:var(--ap-muted)">—</div>
    </div>
  </div>

  <!-- Columna derecha -->
  <div style="display:flex;flex-direction:column;gap:16px;min-width:0">
    <!-- Alertas SMN sobre los lotes (se oculta si no hay) -->
    <div class="card" id="llu-smn-card" style="padding:16px;display:none">
      <div style="font-size:14px;font-weight:600;margin-bottom:8px">⚠ Alertas del SMN sobre tus lotes</div>
      <div id="llu-smn-body"></div>
      <div style="font-size:10px;color:var(--ap-muted);margin-top:6px">Fuente: Servicio Meteorológico Nacional · se actualiza cada 15 min</div>
    </div>

    <div class="card" style="padding:16px">
      <div style="font-size:14px;font-weight:600;margin-bottom:12px">Acumulado mensual (mm)</div>
      <div id="llu-chart" style="display:flex;align-items:flex-end;gap:6px;height:140px;overflow-x:auto;padding-bottom:4px"></div>
    </div>

    <!-- Pronóstico real (Open-Meteo) -->
    <div class="card" id="llu-prono-card" style="padding:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <div>
          <div style="font-size:14px;font-weight:600">🌐 Pronóstico de lluvia · próximos días</div>
          <div style="font-size:11px;color:var(--ap-muted)">Open-Meteo · modelo por ubicación del lote</div>
        </div>
        <button class="btn btn-ghost" style="padding:4px 10px;font-size:11px" onclick="lluCargarPronostico()">↻</button>
      </div>
      <div id="llu-prono-body"><div style="color:var(--ap-muted);font-size:12px">Cargando pronóstico…</div></div>
    </div>

    <div class="card" style="padding:0;overflow:hidden">
      <div id="llu-tabla"></div>
    </div>

    <!-- AgroMet semanal INTA resumido por agrarIA (se oculta si no hay) -->
    <div class="card" id="llu-agromet-card" style="padding:16px;display:none">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:8px">
        <div style="font-size:14px;font-weight:600">🌾 INTA AgroMet <span id="llu-agromet-num"></span></div>
        <a id="llu-agromet-pdf" href="#" target="_blank" rel="noopener" style="font-size:11px;color:var(--ap-green)">Ver informe completo ↗</a>
      </div>
      <div id="llu-agromet-body"></div>
      <div style="font-size:10px;color:var(--ap-muted);margin-top:6px">Fuente: INTA · Instituto de Clima y Agua. Resumen generado por agrarIA.</div>
    </div>
  </div>
</div>

<!-- Modal análisis agrarIA -->
<div class="modal-backdrop" id="modal-llu-ia">
  <div class="modal" style="width:560px;max-height:80vh;display:flex;flex-direction:column">
    <div class="modal-title">✦ agrarIA · Análisis de lluvias</div>
    <div class="modal-sub">Interpretación de lo cargado (no es pronóstico)</div>
    <div id="llu-ia-body" style="margin-top:14px;font-size:14px;line-height:1.6;color:var(--ap-text);overflow:auto;flex:1;white-space:pre-wrap"></div>
    <button class="btn btn-ghost" style="width:100%;margin-top:14px;flex-shrink:0" onclick="closeModal('modal-llu-ia')">Cerrar</button>
  </div>
</div>

<script>
let _lluLote = "";
let _lluData = null;
let _lluPuedeEditar = true;

const MESES_ABR = ["ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"];
const FUENTE = {
  pluviometro: { txt: "Pluviómetro", color: "#A4BA3E" },
  estacion:    { txt: "Estación",    color: "#4aa3ff" },
  openmeteo:   { txt: "Open-Meteo",  color: "#8b95a5" },
};

function lluEscape(s) {
  return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function lluFmtFecha(f) {
  if (!f) return "–";
  const [y, m, d] = f.split("-");
  return `${d}/${m}/${y.slice(2)}`;
}
function lluBadge(fuente) {
  const f = FUENTE[fuente];
  if (!f) return "";
  return `<span style="font-size:9px;color:${f.color};border:1px solid ${f.color};border-radius:4px;padding:1px 5px;vertical-align:middle">${f.txt}</span>`;
}
function lluHoy() {
  return new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);
}

// ── Lotes ─────────────────────────────────────────────────
async function lluCargarLotes() {
  const sel = document.getElementById("llu-sel-lote");
  const selForm = document.getElementById("llu-lote");
  try {
    const r = await Auth.get("/api/lluvias/lotes");
    const lotes = r.lotes || [];
    if (!lotes.length) {
      sel.innerHTML = '<option value="">— sin lotes —</option>';
      selForm.innerHTML = '<option value="">Todo el campo</option>';
      lluRenderVacio("Todavía no hay lotes. Sincronizá un lote desde PilotX o crealo en Lotes.");
      return;
    }
    const opts = lotes.map(n => `<option value="${lluEscape(n)}">${lluEscape(n)}</option>`).join("");
    sel.innerHTML = opts;
    selForm.innerHTML = opts;
    const pedido = new URLSearchParams(location.search).get("lote");
    const inicial = lotes.find(n => n.toLowerCase() === (pedido || "").toLowerCase()) || lotes[0];
    sel.value = inicial;
    lluElegirLote(inicial);
  } catch (e) {
    sel.innerHTML = '<option value="">— error —</option>';
    lluRenderVacio(e.message);
  }
}

function lluElegirLote(nombre) {
  _lluLote = nombre;
  document.getElementById("llu-lote").value = nombre;
  const u = new URL(location.href);
  u.searchParams.set("lote", nombre);
  history.replaceState(null, "", u);
  lluCargarLote();
  lluCargarPronostico();
}

// ── Serie del lote ────────────────────────────────────────
async function lluCargarLote() {
  if (!_lluLote) return;
  const dias = document.getElementById("llu-sel-dias").value;
  document.getElementById("llu-tabla").innerHTML = '<div class="loading" style="padding:20px"><span class="spinner"></span> Consultando fuentes…</div>';
  try {
    const r = await Auth.get(`/api/lluvias?lote=${encodeURIComponent(_lluLote)}&dias=${dias}`);
    _lluData = r;
    _lluPuedeEditar = r.puede_editar !== false;
    document.getElementById("llu-form-card").style.display = _lluPuedeEditar ? "" : "none";
    lluRenderMetrics();
    lluRenderFuentes();
    lluRenderChart();
    lluRenderTabla();
  } catch (e) {
    lluRenderVacio(e.message);
  }
}

function lluRenderVacio(msg) {
  document.getElementById("llu-metrics").innerHTML = "";
  document.getElementById("llu-chart").innerHTML = "";
  document.getElementById("llu-tabla").innerHTML = `<div class="empty-state" style="padding:32px"><span class="icon">🌧</span><p>${lluEscape(msg)}</p></div>`;
}

function lluRenderMetrics() {
  const d = _lluData;
  const mes = lluHoy().slice(0, 7);
  const mesMM = d.dias.filter(x => x.fecha.startsWith(mes)).reduce((a, x) => a + x.mm, 0);
  const ultima = d.registros[0];
  const diasSin = ultima ? Math.max(0, Math.round((new Date(lluHoy()) - new Date(ultima.fecha)) / 86400000)) : null;

  const card = (label, valor, sub) => `
    <div class="card" style="padding:14px 16px">
      <div style="font-size:11px;color:var(--ap-muted);text-transform:uppercase;letter-spacing:1px">${label}</div>
      <div style="font-size:24px;font-weight:700;color:var(--ap-green);margin-top:4px">${valor}</div>
      <div style="font-size:11px;color:var(--ap-muted);margin-top:2px">${sub || ""}</div>
    </div>`;
  const mm = (v) => `${Math.round(v * 10) / 10} <span style='font-size:13px;color:var(--ap-muted)'>mm</span>`;

  document.getElementById("llu-metrics").innerHTML =
    card("Total del período", mm(d.total_mm), `${lluFmtFecha(d.desde)} → hoy · ${d.registros.length} días con lluvia`) +
    card("Este mes", mm(mesMM), mes) +
    card("Última lluvia", ultima ? mm(ultima.mm) : "–", ultima ? `${lluFmtFecha(ultima.fecha)} · ${FUENTE[ultima.fuente]?.txt || ""}` : "sin lluvias") +
    card("Días sin llover", diasSin != null ? diasSin : "–", "desde la última");
}

function lluRenderFuentes() {
  const d = _lluData;
  const box = document.getElementById("llu-fuentes");
  if (!d.punto) {
    box.innerHTML = "Este lote no tiene ubicación (ni origen de PilotX ni contorno), así que solo se ve lo cargado en el pluviómetro.";
    return;
  }
  const pf = d.por_fuente;
  const est = d.estaciones.length
    ? d.estaciones.map(e => `<div>📡 ${lluEscape(e.red_nombre)} · ${lluEscape(e.nombre)} <span style="color:var(--ap-green)">${e.dist_km} km</span> · ${e.dias_con_dato} días con dato</div>`).join("")
    : `<div>📡 No hay estaciones a menos de 15 km.</div>`;
  box.innerHTML = `
    <div style="display:flex;flex-direction:column;gap:6px;color:var(--ap-text)">
      <div>${lluBadge("pluviometro")} ${pf.pluviometro} días</div>
      <div>${lluBadge("estacion")} ${pf.estacion} días</div>
      <div>${lluBadge("openmeteo")} ${pf.openmeteo} días</div>
    </div>
    <div style="margin-top:10px;display:flex;flex-direction:column;gap:4px">${est}</div>
    <div style="margin-top:8px;font-size:11px">Cada día usa una sola fuente: pluviómetro, si no la estación más cercana que midió, y si no Open-Meteo.</div>`;
}

function lluRenderChart() {
  const porMes = {};
  _lluData.dias.forEach(x => { const m = x.fecha.slice(0, 7); porMes[m] = (porMes[m] || 0) + x.mm; });
  const meses = Object.keys(porMes).sort().slice(-12);
  const chart = document.getElementById("llu-chart");
  if (!meses.length) {
    chart.innerHTML = `<div style="color:var(--ap-muted);font-size:12px;align-self:center">Sin datos</div>`;
    return;
  }
  const max = Math.max(...meses.map(m => porMes[m]), 1);
  chart.innerHTML = meses.map(m => {
    const mm = Math.round(porMes[m] * 10) / 10;
    const h = Math.max(4, Math.round((porMes[m] / max) * 110));
    const [y, mo] = m.split("-");
    return `
      <div style="display:flex;flex-direction:column;align-items:center;gap:4px;min-width:36px;flex-shrink:0">
        <div style="font-size:10px;color:var(--ap-green);font-weight:600">${mm}</div>
        <div title="${m}: ${mm} mm" style="width:26px;height:${h}px;background:var(--ap-green-dim);border:1px solid rgba(164,186,62,0.35);border-radius:4px 4px 0 0"></div>
        <div style="font-size:10px;color:var(--ap-muted)">${MESES_ABR[parseInt(mo,10)-1]}<br>${y.slice(2)}</div>
      </div>`;
  }).join("");
}

function lluRenderTabla() {
  const t = document.getElementById("llu-tabla");
  const regs = _lluData.registros;
  if (!regs.length) {
    t.innerHTML = `<div class="empty-state" style="padding:32px"><span class="icon">🌧</span><p>Sin lluvias en el período.</p></div>`;
    return;
  }
  t.innerHTML = `
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <thead>
        <tr style="text-align:left;color:var(--ap-muted);font-size:11px;text-transform:uppercase;letter-spacing:1px">
          <th style="padding:10px 16px">Fecha</th>
          <th style="padding:10px 16px">mm</th>
          <th style="padding:10px 16px">Fuente</th>
          <th style="padding:10px 16px"></th>
        </tr>
      </thead>
      <tbody>
        ${regs.map(r => `
          <tr style="border-top:1px solid var(--ap-border)">
            <td style="padding:8px 16px">${lluFmtFecha(r.fecha)}</td>
            <td style="padding:8px 16px;color:var(--ap-green);font-weight:600">${r.mm}</td>
            <td style="padding:8px 16px;color:var(--ap-muted);font-size:12px">${lluBadge(r.fuente)} ${lluEscape(r.fuente === "pluviometro" ? r.nota : r.nota || "")}</td>
            <td style="padding:8px 16px;text-align:right">
              ${_lluPuedeEditar && r.fuente === "pluviometro" ? (r.ids || []).map(id => `<button class="btn btn-ghost" style="padding:4px 10px;font-size:11px" title="Borrar registro de pluviómetro" onclick="lluBorrar('${lluEscape(id)}')">✕</button>`).join("") : ""}
            </td>
          </tr>`).join("")}
      </tbody>
    </table>`;
}

// ── Pluviómetro ───────────────────────────────────────────
async function lluGuardar() {
  const fecha = document.getElementById("llu-fecha").value;
  const mm    = document.getElementById("llu-mm").value;
  const lote  = document.getElementById("llu-lote").value;
  const nota  = document.getElementById("llu-nota").value;
  const msg   = document.getElementById("llu-form-msg");

  if (!fecha) { msg.textContent = "Poné una fecha."; return; }
  if (mm === "" || Number(mm) < 0) { msg.textContent = "Poné los milímetros."; return; }

  msg.style.color = "var(--ap-muted)";
  msg.textContent = "Guardando…";
  try {
    await Auth.post("/api/lluvias", { fecha, mm: Number(mm), lote, nota });
    document.getElementById("llu-mm").value = "";
    document.getElementById("llu-nota").value = "";
    msg.style.color = "var(--ap-green)";
    msg.textContent = "Guardado ✓";
    if (lote === _lluLote) await lluCargarLote();
    setTimeout(() => { msg.textContent = ""; }, 2000);
  } catch (e) {
    msg.style.color = "var(--ap-red, #e5484d)";
    msg.textContent = e.message;
  }
}

async function lluBorrar(id) {
  if (!confirm("¿Borrar este registro de pluviómetro?")) return;
  try {
    await Auth.del("/api/lluvias/" + encodeURIComponent(id));
    await lluCargarLote();
  } catch (e) { alert(e.message); }
}

async function lluAnalizar() {
  const body = document.getElementById("llu-ia-body");
  body.innerHTML = '<div class="loading"><span class="spinner"></span> agrarIA está analizando…</div>';
  openModal("modal-llu-ia");
  try {
    const r = await Auth.post("/api/lluvias/analizar", { lote: _lluLote });
    body.textContent = r.analisis || "Sin respuesta.";
  } catch (e) {
    body.innerHTML = `<div class="alert error show">${lluEscape(e.message)}</div>`;
  }
}

// ── Alertas SMN ─────────────────────────────────────────────
const SMN_COLOR = { amarilla: "#e6c229", naranja: "#f08c28", roja: "#e5484d" };

async function lluCargarAlertasSMN() {
  const card = document.getElementById("llu-smn-card");
  try {
    const r = await Auth.get("/api/lluvias/smn/alertas");
    const al = r.alertas || [];
    if (!al.length) { card.style.display = "none"; return; }
    const fmt = (iso) => iso ? new Date(iso).toLocaleString("es-AR", { weekday: "short", day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "—";
    document.getElementById("llu-smn-body").innerHTML = al.map(a => `
      <div style="border-left:4px solid ${SMN_COLOR[a.nivel] || "#e6c229"};padding:6px 10px;margin-bottom:8px;background:var(--ap-bg);border-radius:0 6px 6px 0">
        <div style="font-size:13px;font-weight:600">${lluEscape(a.evento)} · nivel ${lluEscape(a.nivel)}</div>
        <div style="font-size:11px;color:var(--ap-muted)">${fmt(a.inicio)} → ${fmt(a.fin)} · ${lluEscape(a.lotes.join(", "))}</div>
        <div style="font-size:12px;margin-top:4px">${lluEscape(a.descripcion || "")}</div>
      </div>`).join("");
    card.style.display = "block";
  } catch { card.style.display = "none"; }
}

// ── AgroMet semanal INTA ────────────────────────────────────
async function lluCargarAgromet() {
  const card = document.getElementById("llu-agromet-card");
  try {
    const r = await Auth.get("/api/lluvias/agromet");
    const inf = r.informe;
    if (!inf) { card.style.display = "none"; return; }
    const [a, m, d] = inf.fecha.split("-");
    document.getElementById("llu-agromet-num").textContent = `N.º ${inf.numero} · ${d}/${m}/${a}`;
    document.getElementById("llu-agromet-pdf").href = inf.pdf || inf.url;
    const propias = inf.provincias.filter(p => p.propia);
    const otras   = inf.provincias.filter(p => !p.propia);
    const bloque = (p) => `
      <div style="margin-top:8px">
        <div style="font-size:12px;font-weight:600">${lluEscape(p.provincia)}</div>
        <ul style="margin:4px 0 0 18px;padding:0;font-size:12px;line-height:1.5">${p.puntos.map(x => `<li>${lluEscape(x)}</li>`).join("")}</ul>
      </div>`;
    document.getElementById("llu-agromet-body").innerHTML =
      `<div style="font-size:12px;line-height:1.5">${lluEscape(inf.general)}</div>` +
      (propias.length ? propias.map(bloque).join("") : "") +
      (otras.length ? `<details style="margin-top:8px"><summary style="cursor:pointer;font-size:11px;color:var(--ap-muted)">${propias.length ? "Otras provincias" : "Por provincia"} (${otras.length})</summary>${otras.map(bloque).join("")}</details>` : "");
    card.style.display = "block";
  } catch { card.style.display = "none"; }
}

// ── Pronóstico real (Open-Meteo) del centroide del campo ──
async function lluCargarPronostico() {
  const body = document.getElementById("llu-prono-body");
  body.innerHTML = '<div style="color:var(--ap-muted);font-size:12px">Cargando pronóstico…</div>';
  try {
    const r = await Auth.get(`/api/lluvias/openmeteo/pronostico?dias=10${_lluLote ? "&lote=" + encodeURIComponent(_lluLote) : ""}`);
    lluRenderPronostico(r);
  } catch (e) {
    body.innerHTML = `<div style="font-size:12px;color:var(--ap-muted)">No se pudo cargar el pronóstico: ${lluEscape(e.message)}</div>`;
  }
}

function lluRenderPronostico(r) {
  const body = document.getElementById("llu-prono-body");
  const dias = (r.dias || []).filter(d => d.futuro);
  if (!dias.length) {
    body.innerHTML = '<div style="font-size:12px;color:var(--ap-muted)">Sin datos de pronóstico.</div>';
    return;
  }
  const max = Math.max(...dias.map(d => d.mm), 1);
  const barras = dias.map(d => {
    const mm = Math.round(d.mm * 10) / 10;
    const h  = Math.max(3, Math.round((d.mm / max) * 90));
    const [, mo, da] = d.fecha.split("-");
    const dow = new Date(d.fecha + "T00:00:00").getDay();
    const dl = ["do","lu","ma","mi","ju","vi","sa"][dow];
    return `
      <div style="display:flex;flex-direction:column;align-items:center;gap:4px;min-width:34px;flex-shrink:0">
        <div style="font-size:10px;color:${mm > 0 ? "#4aa3ff" : "var(--ap-muted)"};font-weight:600">${mm}</div>
        <div title="${d.fecha}: ${mm} mm" style="width:22px;height:${h}px;background:${mm > 0 ? "rgba(74,163,255,0.4)" : "var(--ap-border)"};border:1px solid rgba(74,163,255,0.35);border-radius:4px 4px 0 0"></div>
        <div style="font-size:10px;color:var(--ap-muted);text-align:center">${dl}<br>${da}/${mo}</div>
      </div>`;
  }).join("");
  body.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
      <div style="font-size:12px;color:var(--ap-muted)">Acumulado esperado</div>
      <div style="font-size:20px;font-weight:700;color:#4aa3ff">${r.total_pronostico ?? 0} <span style="font-size:12px;color:var(--ap-muted)">mm</span></div>
    </div>
    <div style="display:flex;align-items:flex-end;gap:6px;height:120px;overflow-x:auto;padding-bottom:4px">${barras}</div>
    <div style="font-size:10px;color:var(--ap-muted);margin-top:6px">${r.punto?.origen === "lote" ? "Ubicación: el lote · " : r.punto?.origen === "centroide" ? "Ubicación: centroide del campo · " : ""}${r.plan === "pago" ? "Open-Meteo (tu suscripción)" : "Open-Meteo (plan gratuito)"}</div>`;
}


document.addEventListener("DOMContentLoaded", () => {
  document.getElementById("llu-fecha").value = lluHoy();
  lluCargarLotes();
  lluCargarAlertasSMN();
  lluCargarAgromet();
});
</script>
