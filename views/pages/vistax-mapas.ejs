<%# pages/vistax-mapas.ejs — Viewer de shapefiles VistaX (sesiones de siembra) %>

<link rel="stylesheet" href="/lib/leaflet/leaflet.min.css">
<script src="/lib/leaflet/leaflet.min.js"></script>

<div class="page-header">
  <div>
    <h2>VistaX — Mapas de sesión</h2>
    <p>Shapefiles sincronizados de AOG · Puntos por surco coloreados por SPM · heatmap por celda</p>
  </div>
  <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
    <select id="vxm-sesion" class="input" style="min-width:340px">
      <option value="">Cargando sesiones...</option>
    </select>
    <a href="/vistax-mapas" class="btn">↻ Actualizar</a>
  </div>
</div>

<div style="display:flex; gap:8px; align-items:center; margin-bottom:10px; flex-wrap:wrap">
  <div id="vxm-info" style="font-size:12px; color:var(--muted2); flex:1; min-width:200px">
    Cargando...
  </div>
  <div style="display:flex; gap:4px">
    <button id="vxm-btn-puntos" class="btn btn-sm btn-primary" onclick="mostrarCapa('puntos')">● Puntos</button>
    <button id="vxm-btn-heatmap" class="btn btn-sm" onclick="mostrarCapa('heatmap')" disabled>▦ Heatmap</button>
  </div>
</div>

<div id="vxm-mapa" style="height:calc(100vh - 320px); min-height:420px; border-radius:10px; overflow:hidden; background:#0a0a0a"></div>

<div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-top:8px; flex-wrap:wrap">
  <div id="vxm-leyenda" style="font-size:11px; color:var(--muted2)">
    <strong>Leyenda SPM</strong>:
    <span style="color:#ff1744">● tapado</span> ·
    <span style="color:#ff9100">● bajo (&lt;4)</span> ·
    <span style="color:#ffea00">● medio (4–7)</span> ·
    <span style="color:#76ff03">● bueno (7–10)</span> ·
    <span style="color:#00e676">● excelente (≥10)</span>
  </div>
  <div id="vxm-leyenda-heatmap" style="font-size:11px; color:var(--muted2); display:none">
    <strong>Leyenda heatmap</strong> (celda ≈5m):
    <span style="color:#ff1744">■ falla</span> ·
    <span style="color:#ff9100">■ bajo</span> ·
    <span style="color:#ffea00">■ medio</span> ·
    <span style="color:#00e676">■ bueno</span>
  </div>
  <div id="vxm-descargas" style="font-size:11px; color:var(--muted2)"></div>
</div>

<script src="/js/vistax-mapas.js"></script>
